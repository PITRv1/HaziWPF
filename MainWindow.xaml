<Window x:Class="DogaTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DogaTest"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok" Height="820" Width="1240"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        FontSize="14"
        >
    <Border Padding="20">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="#19324D"
                       >Atlétikai verseny</TextBlock>
            <TextBlock Foreground="#52657A" >A versenyzok regisztracioja es rajtszamok kiosztasa</TextBlock>
        </StackPanel>

            <Border Grid.Row="1"
                BorderBrush="#D4DDE7"
            Background="White"
                    
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,10,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>

                    </Grid.RowDefinitions>

                    <TextBlock FontSize="20" FontWeight="Bold">Új versenyző</TextBlock>
                    
                    <StackPanel Grid.Row="1">
                        <TextBlock>Versenyzo neve:</TextBlock>
                        <TextBox></TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock>Versenyszam:</TextBlock>
                        <ComboBox IsEditable="False">
                            <ComboBoxItem IsSelected="False">100m</ComboBoxItem>
                            <ComboBoxItem>200m</ComboBoxItem>
                            <ComboBoxItem>400m</ComboBoxItem>
                            <ComboBoxItem>800m</ComboBoxItem>
                            <ComboBoxItem>1500m</ComboBoxItem>
                            <ComboBoxItem>Tavolugras</ComboBoxItem>
                            <ComboBoxItem>Magasugras</ComboBoxItem>
                            <ComboBoxItem>Sulylokes</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                        
                     <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nem:" VerticalAlignment="Center"></TextBlock>
                        <RadioButton Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Ferfi" GroupName="Nem" ></RadioButton>
                        <RadioButton Grid.Column="2" VerticalAlignment="Center" Content="No" GroupName="Nem" ></RadioButton>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <Grid>
                            <TextBlock Text="Eletkor:" HorizontalAlignment="Left"/>
                            <TextBlock Text="18 ev" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Right"/>
                        </Grid>

                        <Slider Minimum="18"
                                Maximum="90"
                                Value="18"
                                TickPlacement="BottomRight"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                Margin="10,0,10,-5"></Slider>

                        <Grid>
                            <TextBlock Text="18" HorizontalAlignment="Left"/>
                            <TextBlock Text="90" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="5">
                        <TextBlock FontWeight="Bold">Korabbi eredmenyek</TextBlock>
                        <CheckBox>Olimpiai csucs</CheckBox>
                        <CheckBox>Vilagbajnoki csucs</CheckBox>
                        <CheckBox>Europa-bajnoki csucs</CheckBox>
                    </StackPanel>

                    <Grid Grid.Row="6" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Igenyelt rajtaszam:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Padding="6"/>
                    </Grid>
                    
                    <TextBlock VerticalAlignment="Center" Grid.Row="7" FontSize="10">Ures mezo: automatikus kiosztas.</TextBlock>
                    
                    <Button VerticalAlignment="Bottom" Grid.Row="8" Height="36" Background="#DDEBFA" Content="REGISZTRAL"></Button>

                </Grid>
            
            </Border>
        
        <Border Grid.Column="1"
                Grid.Row="1"
            Background="White"
                
                BorderBrush="#D4DDE7"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="10,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Regisztralt versenyzok"></TextBlock>
                        <TextBlock Text="Rajtszam | Nev | Versenyszam | Nem | Kor | O | VB | EB"></TextBlock>

                    </StackPanel>

                    <Border Grid.Row="1"
                        Margin="6"
                        BorderBrush="#D4DDE7">
                        <ListBox>

                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="2" Text="O = olimpiai, VB = vilagbajnoki, EB = europa-bajnoki csucs"></TextBlock>

                </Grid>
            
        </Border>

        <Border Grid.Row="2"
            Grid.ColumnSpan="2"
            Background="White"
            BorderBrush="#D4DDE7"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,16,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Regisztral Versenyzok Szama: 0"></TextBlock>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Button Width="210" Height="32" Margin="0,0,8,0" Content="FAJLBA MENTES" Grid.Column="0"></Button>
                        <Button Width="210" Height="32" Margin="8,0,0,0" Content="FAJBOL BETOLTES" Grid.Column="1"></Button>

                    </Grid>
                </Grid>
            
                
                
        </Border>
        
        



        </Grid>
    </Border>
</Window>
