<Window x:Class="DogaTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DogaTest"
        mc:Ignorable="d"
        Title="Atlétikai verseny - Rajtszámok" Height="820" Width="1440"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        FontSize="14"
        >
    <Border Padding="20">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="#19324D"
                       >Atlétikai verseny</TextBlock>
            <TextBlock Foreground="#52657A" >Versenyzők regisztrációja és rajtszámok kiosztása</TextBlock>
        </StackPanel>

            <Border Grid.Row="1"
                BorderBrush="#D4DDE7"
            Background="White"
                    
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,10,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>

                    </Grid.RowDefinitions>

                    <TextBlock FontSize="20" FontWeight="Bold">Új versenyző</TextBlock>
                    
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Margin="0,0,0,4">Versenyző neve:</TextBlock>
                        <TextBox x:Name="txtNev" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"></TextBox>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Margin="0,0,0,4">Versenyszám:</TextBlock>
                        <ComboBox x:Name="cmbVersenyszam" Height="32" IsEditable="False" SelectedIndex="-1" VerticalContentAlignment="Center">
                            <ComboBoxItem>100 m</ComboBoxItem>
                            <ComboBoxItem>200 m</ComboBoxItem>
                            <ComboBoxItem>400 m</ComboBoxItem>
                            <ComboBoxItem>800 m</ComboBoxItem>
                            <ComboBoxItem>1500 m</ComboBoxItem>
                            <ComboBoxItem>Távolugrás</ComboBoxItem>
                            <ComboBoxItem>Magasugrás</ComboBoxItem>
                            <ComboBoxItem>Súlylökés</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                        
                     <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nem:" VerticalAlignment="Center"></TextBlock>
                        <RadioButton x:Name="rbFerfi" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Férfi" GroupName="Nem" ></RadioButton>
                        <RadioButton x:Name="rbNo" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Nő" GroupName="Nem" ></RadioButton>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Grid>
                            <TextBlock Text="Életkor:" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="txtEletkor" Text="18 év" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Right"/>
                        </Grid>

                        <Slider x:Name="sldEletkor"
                                Minimum="18"
                                Maximum="90"
                                Value="18"
                                TickPlacement="BottomRight"
                                IsSnapToTickEnabled="True"
                                TickFrequency="1"
                                ValueChanged="Eletkor_Valtozott"
                                Margin="10,0,10,-5"></Slider>

                        <Grid>
                            <TextBlock Text="18" HorizontalAlignment="Left"/>
                            <TextBlock Text="90" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,10,0,0">
                        <TextBlock FontWeight="Bold" FontSize="16">Korábbi eredmények</TextBlock>
                        <CheckBox x:Name="chkOlimpiai" Margin="0,6,0,0">Olimpiai csúcs (OR)</CheckBox>
                        <CheckBox x:Name="chkVB" Margin="0,6,0,0">Világcsúcs (VR)</CheckBox>
                        <CheckBox x:Name="chkEB" Margin="0,6,0,0">Európa-csúcs (ER)</CheckBox>
                    </StackPanel>

                    <Grid Grid.Row="6" Height="32" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Igényelt rajtszám:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="txtRajtszam" Grid.Column="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"/>
                    </Grid>
                    
                    <TextBlock VerticalAlignment="Center" Grid.Row="7" Margin="0,6,0,0" FontSize="12" Foreground="#52657A">Üres mező: automatikus kiosztás.</TextBlock>
                    
                    <Button x:Name="btnRegisztral" VerticalAlignment="Bottom" Grid.Row="8" Height="36" Background="#DDEBFA" Content="REGISZTRÁL" Click="Regisztral_Click"></Button>

                </Grid>
            
            </Border>
        
        <Border Grid.Column="1"
                Grid.Row="1"
            Background="White"
                
                BorderBrush="#D4DDE7"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="10,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="20" FontWeight="Bold" Text="Regisztrált versenyzők"></TextBlock>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Eredményszűrő:" VerticalAlignment="Center" Margin="0,0,12,0"></TextBlock>
                            <ComboBox x:Name="cmbRekordSzuro" Width="340" Height="32" IsEditable="False" SelectedIndex="0" VerticalContentAlignment="Center">
                                <ComboBoxItem>Összes</ComboBoxItem>
                                <ComboBoxItem>OR - olimpiai csúcs</ComboBoxItem>
                                <ComboBoxItem>VR - világcsúcs</ComboBoxItem>
                                <ComboBoxItem>ER - Európa-csúcs</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>

                    <DataGrid x:Name="dgVersenyzok"
                              Grid.Row="1"
                              Margin="0,12,0,12"
                              ItemsSource="{Binding Versenyzok, Mode=OneWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeight="32"
                              ColumnHeaderHeight="38"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E3E9F0"
                              AlternatingRowBackground="#F4F7FB"
                              Background="White"
                              BorderBrush="#D4DDE7">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}">
                                <Setter Property="Background" Value="#19324D" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rajtszám" Width="88" Binding="{Binding Rajtszam, Mode=OneWay}" />
                            <DataGridTextColumn Header="Név" Width="*" Binding="{Binding Nev, Mode=OneWay}" />
                            <DataGridTextColumn Header="Versenyszám" Width="160" Binding="{Binding Versenyszam, Mode=OneWay}" />
                            <DataGridTextColumn Header="Nem" Width="70" Binding="{Binding Nem, Mode=OneWay}" />
                            <DataGridTextColumn Header="Életkor" Width="80" Binding="{Binding Eletkor, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="OR" Width="80" Binding="{Binding OR, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="VR" Width="80" Binding="{Binding VR, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="ER" Width="80" Binding="{Binding ER, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="#52657A" Margin="0,0,24,0" Text="OR = olimpiai csúcs"></TextBlock>
                        <TextBlock FontSize="12" Foreground="#52657A" Margin="0,0,24,0" Text="VR = világcsúcs"></TextBlock>
                        <TextBlock FontSize="12" Foreground="#52657A" Text="ER = Európa-csúcs"></TextBlock>
                    </StackPanel>

                </Grid>
            
        </Border>

        <Border Grid.Row="2"
            Grid.ColumnSpan="2"
            Background="White"
            BorderBrush="#D4DDE7"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,16,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="txtLetszam" VerticalAlignment="Center" Text="Látható: 0 / Összesen: 0"></TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnMentes" Width="210" Height="32" Margin="0,0,16,0" Content="FÁJLBA MENTÉS" Click="Mentes_Click"></Button>
                        <Button x:Name="btnBetoltes" Width="210" Height="32" Content="FÁJLBÓL BETÖLTÉS" Click="Betoltes_Click"></Button>
                    </StackPanel>
                </Grid>
            
                
                
        </Border>
        
        
        </Grid>
    </Border>
</Window>
